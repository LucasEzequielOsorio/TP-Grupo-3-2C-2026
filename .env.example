# Plantilla de configuración. Copiar a .env y completar los valores:
#   Copy-Item .env.example .env
# El archivo .env es privado y NO se sube a Git (está en .gitignore).

# --- Base de datos MySQL (la usa docker compose y el backend) ---
# Los valores de ejemplo sirven para desarrollo local; se pueden cambiar
# antes de crear la base por primera vez.
MYSQL_DATABASE=tienda_ropa
MYSQL_USER=tienda
MYSQL_PASSWORD=tienda_dev_123
MYSQL_ROOT_PASSWORD=root_dev_123
MYSQL_HOST=127.0.0.1
# Si el puerto 3306 está ocupado en tu compu, usar otro (por ejemplo 3307).
MYSQL_PORT=3306

# --- Backend (API Node) ---
API_PORT=3000
# Clave para firmar las sesiones (JWT). OBLIGATORIA: mínimo 32 caracteres.
# Generar una con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Administrador inicial (lo crea: npm --prefix backend run admin:create) ---
# Contraseña: mínimo 8 caracteres, con mayúscula, minúscula y número.
ADMIN_EMAIL=admin@tienda.local
ADMIN_PASSWORD=

# --- Recuperación de contraseña y correo ---
# Origen del front, sin rutas. Los enlaces de los mails usan este valor.
# Con npm --prefix backend run preview: http://127.0.0.1:3000.
# Para Mercado Pago: usar el mismo origen HTTPS público que MP_BACK_URL.
APP_URL=http://127.0.0.1:4200
# Por defecto los mails se capturan en Mailpit (http://127.0.0.1:8025),
# que corre con docker compose y no envía nada a Internet.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Solo para un SMTP real (dejar vacío en local):
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TRAMA <no-reply@tienda.local>

# --- Mercado Pago (opcional, solo para probar pagos con cuentas de prueba) ---
# Ver backend/README.md (sección Mercado Pago) y DEMO-MERCADO-PAGO.md.
# Sin estos valores la tienda funciona igual, solo se desactiva el pago.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
# Las dos URLs deben ser HTTPS públicas (por ejemplo un túnel de Cloudflare).
# MP_NOTIFICATION_URL termina en /api/pagos/mercadopago/webhook
MP_BACK_URL=
MP_NOTIFICATION_URL=
